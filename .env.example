# Copy to .env.local. All values below are deliberately empty.
# Browser: only these two Supabase variables are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server: movies, series and optional anime artwork.
TMDB_API_KEY=
FANART_API_KEY=

# Server: IGDB is the default game provider. RAWG is optional legacy mode.
GAME_CATALOG_PROVIDER=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=

# Server: privileged caches and Steam integration. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STEAM_WEB_API_KEY=
STEAM_SITE_URL=

# Optional anime provider overrides; leave empty to use the built-in defaults.
ANIME_CATALOG_PROVIDER=
JIKAN_EDGE_BASE_URL=

# Optional per-instance budgets, not global billing limits.
VOID_SEARCH_REQUESTS_PER_MINUTE=
VOID_TMDB_MINUTE_BUDGET=
VOID_TMDB_DAILY_BUDGET=
VOID_IGDB_MINUTE_BUDGET=
VOID_IGDB_DAILY_BUDGET=
VOID_RAWG_MINUTE_BUDGET=
VOID_RAWG_DAILY_BUDGET=

# Edge Function environment (configure separately in Supabase, comma-separated origins).
VOID_ALLOWED_ORIGINS=

# Optional shared Postgres quotas: enable only after reviewing the local migration.
VOID_GLOBAL_BUDGETS_ENABLED=
VOID_GLOBAL_TMDB_MINUTE=
VOID_GLOBAL_TMDB_DAILY=
VOID_GLOBAL_RAWG_MINUTE=
VOID_GLOBAL_RAWG_DAILY=
VOID_GLOBAL_IGDB_MINUTE=
VOID_GLOBAL_IGDB_DAILY=
VOID_GLOBAL_TWITCH_MINUTE=
VOID_GLOBAL_TWITCH_DAILY=
VOID_GLOBAL_ANILIST_MINUTE=
VOID_GLOBAL_ANILIST_DAILY=
VOID_GLOBAL_FANART_MINUTE=
VOID_GLOBAL_FANART_DAILY=
VOID_GLOBAL_JIKAN_MINUTE=
VOID_GLOBAL_JIKAN_DAILY=
VOID_GLOBAL_STEAM_MINUTE=
VOID_GLOBAL_STEAM_DAILY=
